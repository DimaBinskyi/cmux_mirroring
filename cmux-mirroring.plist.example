<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd template: replace /path/to/node and /path/to/cmux_mirroring,
     save as ~/Library/LaunchAgents/com.cmux-mirroring.plist, then:
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.cmux-mirroring.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cmux-mirroring</string>
  <key>ProgramArguments</key>
  <array>
    <string>/path/to/node</string>
    <string>/path/to/cmux_mirroring/server.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/path/to/cmux_mirroring</string>
  <!-- UV_THREADPOOL_SIZE: a folder macOS has not granted this agent (Desktop,
       Downloads, Documents) blocks its libuv thread until someone answers a
       consent dialog, and the default pool is 4. Add CMUX_BIN here too when cmux
       is not at /Applications/cmux.app: launchd hands the agent a bare
       /usr/bin:/bin:/usr/sbin:/sbin PATH, so a cmux CLI elsewhere is not found.
       See the README's env table for the rest. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>UV_THREADPOOL_SIZE</key><string>16</string>
    <!-- <key>CMUX_BIN</key><string>/opt/homebrew/bin/cmux</string> -->
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/path/to/cmux_mirroring/data/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/path/to/cmux_mirroring/data/stderr.log</string>
</dict>
</plist>
